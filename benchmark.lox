var N = 10000000;
fun benchmark(name,f,doPrint) {
    var a = clock();
    f();
    if (doPrint) print (clock() - a);
}

fun bench_sum_of_squares() {
    var r = 0;
    for(var i=0; i < N; i = i + 1){
        r = r + i * i;
    }
    print r;
}

benchmark("bench_sum_of_squares",bench_sum_of_squares,true);