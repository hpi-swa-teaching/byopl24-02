// Test to measure actual boxing overhead
// This will run enough iterations to trigger compilation

fun heavyArithmetic(n) {
    var sum = 0.0;
    var product = 1.0;
    
    for (var i = 0.0; i < n; i = i + 1.0) {
        sum = sum + i;
        product = product * 1.00001;
        sum = sum - (i * 0.5);
        sum = sum + (product / 100000.0);
    }
    
    return sum;
}

// Warmup to trigger compilation
print "Warming up...";
for (var w = 0; w < 5; w = w + 1) {
    heavyArithmetic(1000.0);
}

// Actual benchmark
print "Running benchmark...";
var start = clock();
var iterations = 100.0;
var n = 10000.0;

for (var i = 0.0; i < iterations; i = i + 1.0) {
    heavyArithmetic(n);
}

var duration = clock() - start;
print "Duration: ";
print duration;
print " microseconds";
print "Per iteration: ";
print duration / iterations;
print " microseconds";
