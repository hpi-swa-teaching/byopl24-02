load("benchmark.lox");

class Storage 🤝 Benchmark {
    init() {
        super.init();
        self.count = 0;
        self.seed = 74755;
    }

    floor(x) {
        var r = round(x);
        if (r > x) {
            return r - 1;
        } else {
            return r;
        }
    }

    mod(a, b) {
        var result = a - self.floor(a / b) * b;
        return result;
    }

    random() {
        self.seed = self.mod((self.seed * 1309) + 13849, 65536);
        return self.seed;
    }

    buildTreeDepth(depth) {
        self.count = self.count + 1;

        if (depth == 1) {
            return self.mod(self.random(), 10) + 1;
        } else {
            var arr = 👉👈;
            for (var i = 0; i < 4; i = i + 1) {
                arr👉i👈 = self.buildTreeDepth(depth - 1);
            }
            return arr;
        }
    }

    benchmark() {
        self.count = 0;
        self.seed = 74755;
        self.buildTreeDepth(7);
        return self.count;
    }

    verifyResult(result) {
        return 5461 == result;
    }
}

return Storage();
