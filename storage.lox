load("benchmark.lox");
load("som.lox");

class Storage 🤝 Benchmark {
    init() {
        self.count = 0;
    }

    benchmark() {
        var random = Random();
        self.count = 0;
        self.buildTreeDepth(7, random);
        return self.count;
    }

    verifyResult(result) {
        return result == 5461;
    }

    buildTreeDepth(depth, random) {
        self.count = self.count + 1;
        if (depth == 1) {
            var temp = random.next();
            var quotient = temp / 10;
            var floored = Math.floor(quotient);
            var size = (temp - (floored * 10)) + 1;
            var arr = 👉👈;
            for (var i = 0; i < size; i = i + 1) {
                arr👉i👈 = nil;
            }
            return arr;
        }

        var arr = 👉👈;
        for (var i = 0; i < 4; i = i + 1) {
            arr👉i👈 = self.buildTreeDepth(depth - 1, random);
        }
        return arr;
    }
}

return Storage();
