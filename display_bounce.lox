var Math = lookup("java","java.lang.Math");
var Color = lookup("java","java.awt.Color");
var LoxDisplay = lookup("java", "de.hpi.swa.lox.runtime.LoxDisplay");

var xLimit = 1000;
var yLimit = 1000;
class Ball {
    init() {
        self.x = Math.random() * xLimit;
        self.y = Math.random() * yLimit;
        self.xVel = (Math.random() * 30) - 15;
        self.yVel = (Math.random() * 30) - 15;
    }

    bounce() {
        var bounced = false;
        var factor = 0.001;
        self.x = self.x + factor * self.xVel;
        self.y = self.y + factor * self.yVel;
        if (self.x > xLimit) {
            self.x = xLimit;
            self.xVel = 0 - Math.abs(self.xVel);
            bounced = true;
        }
        if (self.x < 0) {
            self.x = 0;
            self.xVel = Math.abs(self.xVel);
            bounced = true;
        }
        if (self.y > yLimit) {
            self.y = yLimit;
            self.yVel = 0 - Math.abs(self.yVel);
            bounced = true;
        }
        if (self.y < 0) {
            self.y = 0;
            self.yVel = Math.abs(self.yVel);
            bounced = true;
        }
        return bounced;
    }
}

class Bounce {
    run() {
        self.setupDisplay();
        var ballCount = 1000;
        var bounces = 0;
        var balls = 👉👈;
        self.balls = balls;
        var i = 0;
        for (i = 0; i < ballCount; i = i + 1) {
            balls👉i👈 = Ball();
        }

        while(true) {
            for (var j = 0; j < balls.length; j = j + 1) {
                var ball = balls👉j👈;
                if (ball.bounce()) {
                    bounces = bounces + 1;
            }
            self.display.panel.repaint();
            }
        }
    }

    paint(graphics2D) {
        graphics2D.setColor(Color.BLUE);
        for (var j = 0; j < self.balls.length; j = j + 1) {
            var ball = self.balls👉j👈;
            graphics2D.fillOval(round(ball.x), round(ball.y), 5, 5);
        }
    }
    setupDisplay() {
        self.display = LoxDisplay.create();
        self.display.paint = self.paint;
        self.display.frame.setSize(xLimit, yLimit);
    }
}

Bounce().run();
    