var Math = lookup("java", "java.lang.Math");

class Random {
    init() {
        self.seed = 74755;
    }

    next() {
        var temp = self.seed * 1309 + 13849;
        var quotient = temp / 65536;
        var floored = Math.floor(quotient);
        self.seed = temp - (floored * 65536);
        return self.seed;
    }
}

// Vector class for dynamic arrays (will add more as needed for other benchmarks)
class Vector {
    init() {
        self.storage = 👉👈;
        self.firstIdx = 0;
        self.lastIdx = 0;
    }

    at(idx) {
        if (idx >= self.storage.length) {
            return nil;
        }
        return self.storage👉idx👈;
    }

    atPut(idx, val) {
        if (idx >= self.storage.length) {
            var newLength = idx + 1;
            for (var i = self.storage.length; i < newLength; i = i + 1) {
                self.storage👉i👈 = nil;
            }
        }
        self.storage👉idx👈 = val;
        if (self.lastIdx < idx + 1) {
            self.lastIdx = idx + 1;
        }
    }

    append(elem) {
        self.atPut(self.lastIdx, elem);
    }

    isEmpty() {
        return self.lastIdx == self.firstIdx;
    }

    size() {
        return self.lastIdx - self.firstIdx;
    }

    removeFirst() {
        if (self.isEmpty()) {
            return nil;
        }
        self.firstIdx = self.firstIdx + 1;
        return self.storage👉self.firstIdx - 1👈;
    }

    remove(obj) {
        var newArray = 👉👈;
        var newLast = 0;
        for (var i = 0; i < self.storage.length; i = i + 1) {
            if (self.storage👉i👈 != obj) {
                newArray👉newLast👈 = self.storage👉i👈;
                newLast = newLast + 1;
            }
        }
        self.storage = newArray;
        self.lastIdx = newLast;
        self.firstIdx = 0;
    }

    removeAll() {
        self.storage = 👉👈;
        self.firstIdx = 0;
        self.lastIdx = 0;
    }

    getOne(idx) {
        return self.storage👉self.firstIdx + idx👈;
    }

    hasSome(fn) {
        var storage = self.storage;
        for (var element of storage) {
            if (fn(element)) {
                return true;
            }
        }
        return false;
    }
}
