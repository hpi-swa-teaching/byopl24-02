  "benchmark_framework": {
    "base_class": "Benchmark",
    "base_class_file": "/Users/antonykamp/Projects/hpi-ma/byopl24-02/benchmark.lox",
    "required_methods": [
      "init() - Initialize benchmark state",
      "benchmark() - Execute the benchmark and return result",
      "verifyResult(result) - Verify the result is correct (returns boolean)"
    ],
    "provided_methods": [
      "innerBenchmarkLoop(innerIterations) - Runs benchmark multiple times and validates results"
    ],
    "execution_flow": [
      "1. harness.lox processes command-line arguments (ARGV)",
      "2. harness.lox creates Run instance with benchmark name",
      "3. Run.loadBenchmark() loads the benchmark file using load()",
      "4. Run.runBenchmark() executes the benchmark",
      "5. Run.measure() times execution using clock() built-in",
      "6. Benchmark.innerBenchmarkLoop() runs benchmark N times",
      "7. Each iteration calls benchmark() and verifyResult()",
      "8. Results are printed in microseconds"
    ],
    "timing_mechanism": "Uses built-in clock() function, converts to microseconds (×1000×1000)"
  },
