// The Computer Language Benchmarks Game
// http://shootout.alioth.debian.org/
//
// Based on nbody.java and adapted based on the SOM version.

load("benchmark.lox");
load("som.lox");

var PI = 3.141592653589793;
var PI_SQUARED = PI * PI;
var SOLAR_MASS = 4 * PI_SQUARED;
var DAYS_PER_YEAR = 365.24;

class Body {
    init(x, y, z, vx, vy, vz, mass) {
        self.x = x;
        self.y = y;
        self.z = z;
        self.vx = vx * DAYS_PER_YEAR;
        self.vy = vy * DAYS_PER_YEAR;
        self.vz = vz * DAYS_PER_YEAR;
        self.mass = mass * SOLAR_MASS;
    }

    offsetMomentum(px, py, pz) {
        self.vx = 0 - (px / SOLAR_MASS);
        self.vy = 0 - (py / SOLAR_MASS);
        self.vz = 0 - (pz / SOLAR_MASS);
    }
}

fun jupiter() {
    return Body(
        4.84143144246472090,
        (0 - 1.16032004402742839),
        (0 - 0.103622044471123109),
        0.00166007664274403694,
        0.00769901118419740425,
        (0 - 0.0000690460016972063023),
        0.000954791938424326609
    );
}

