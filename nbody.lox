load("benchmark.lox");

class Body {
    init(x, y, z, vx, vy, vz, mass) {
        self.x = x;
        self.y = y;
        self.z = z;
        self.vx = vx;
        self.vy = vy;
        self.vz = vz;
        self.mass = mass;
    }
}

class NBody 🤝 Benchmark {
    init() {
        super.init();
        self.PI = 3.141592653589793;
        self.SOLAR_MASS = 4 * self.PI * self.PI;
        self.DAYS_PER_YEAR = 365.24;
    }

    createBodies() {
        var bodies = 👉👈;

        bodies👉0👈 = Body(0, 0, 0, 0, 0, 0, self.SOLAR_MASS);

        bodies👉1👈 = Body(
            4.84143144246472090,
            -1.16032004402742839,
            -0.103622044471123109,
            0.00166007664274403694 * self.DAYS_PER_YEAR,
            0.00769901118419740425 * self.DAYS_PER_YEAR,
            -0.0000690460016972063023 * self.DAYS_PER_YEAR,
            0.000954791938424326609 * self.SOLAR_MASS
        );

        bodies👉2👈 = Body(
            8.34336671824457987,
            4.12479856412430479,
            -0.403523417114321381,
            -0.00276742510726862411 * self.DAYS_PER_YEAR,
            0.00499852801234917238 * self.DAYS_PER_YEAR,
            0.0000230417297573763929 * self.DAYS_PER_YEAR,
            0.000285885980666130812 * self.SOLAR_MASS
        );

        bodies👉3👈 = Body(
            12.8943695621391310,
            -15.1111514016986312,
            -0.223307578892655734,
            0.00296460137564761618 * self.DAYS_PER_YEAR,
            0.00237847173959480950 * self.DAYS_PER_YEAR,
            -0.0000296589568540237556 * self.DAYS_PER_YEAR,
            0.0000436624404335156298 * self.SOLAR_MASS
        );

        bodies👉4👈 = Body(
            15.3796971148509165,
            -25.9193146099879641,
            0.179258772950371181,
            0.00268067772490389322 * self.DAYS_PER_YEAR,
            0.00162824170038242295 * self.DAYS_PER_YEAR,
            -0.0000951592254519715870 * self.DAYS_PER_YEAR,
            0.0000515138902046611451 * self.SOLAR_MASS
        );

        return bodies;
    }

    sqrt(x) {
        var guess = x / 2;
        var prev = 0;
        var epsilon = 0.0000000001;

        while ((guess - prev > epsilon) or (prev - guess > epsilon)) {
            prev = guess;
            guess = (guess + x / guess) / 2;
        }

        return guess;
    }

    advance(bodies, nbody, dt) {
        for (var i = 0; i < nbody; i = i + 1) {
            var bi = bodies👉i👈;
            var bix = bi.x;
            var biy = bi.y;
            var biz = bi.z;
            var bimass = bi.mass;
            var bivx = bi.vx;
            var bivy = bi.vy;
            var bivz = bi.vz;

            for (var j = i + 1; j < nbody; j = j + 1) {
                var bj = bodies👉j👈;
                var dx = bix - bj.x;
                var dy = biy - bj.y;
                var dz = biz - bj.z;
                var distance = self.sqrt(dx * dx + dy * dy + dz * dz);
                var mag = dt / (distance * distance * distance);
                var bim = bimass * mag;
                var bjm = bj.mass * mag;

                bivx = bivx - dx * bjm;
                bivy = bivy - dy * bjm;
                bivz = bivz - dz * bjm;
                bj.vx = bj.vx + dx * bim;
                bj.vy = bj.vy + dy * bim;
                bj.vz = bj.vz + dz * bim;
            }

            bi.vx = bivx;
            bi.vy = bivy;
            bi.vz = bivz;
        }

        for (var i = 0; i < nbody; i = i + 1) {
            var bi = bodies👉i👈;
            bi.x = bi.x + dt * bi.vx;
            bi.y = bi.y + dt * bi.vy;
            bi.z = bi.z + dt * bi.vz;
        }
    }

    energy(bodies, nbody) {
        var e = 0;

        for (var i = 0; i < nbody; i = i + 1) {
            var bi = bodies👉i👈;
            var vx = bi.vx;
            var vy = bi.vy;
            var vz = bi.vz;
            var bim = bi.mass;
            e = e + 0.5 * bim * (vx * vx + vy * vy + vz * vz);

            for (var j = i + 1; j < nbody; j = j + 1) {
                var bj = bodies👉j👈;
                var dx = bi.x - bj.x;
                var dy = bi.y - bj.y;
                var dz = bi.z - bj.z;
                var distance = self.sqrt(dx * dx + dy * dy + dz * dz);
                e = e - (bim * bj.mass) / distance;
            }
        }

        return e;
    }

    offsetMomentum(bodies, nbody) {
        var px = 0;
        var py = 0;
        var pz = 0;

        for (var i = 0; i < nbody; i = i + 1) {
            var bi = bodies👉i👈;
            var bim = bi.mass;
            px = px + bi.vx * bim;
            py = py + bi.vy * bim;
            pz = pz + bi.vz * bim;
        }

        var sun = bodies👉0👈;
        sun.vx = 0 - px / self.SOLAR_MASS;
        sun.vy = 0 - py / self.SOLAR_MASS;
        sun.vz = 0 - pz / self.SOLAR_MASS;
    }

    benchmark() {
        var n = 1000;
        var bodies = self.createBodies();
        var nbody = 5;

        self.offsetMomentum(bodies, nbody);
        var initialEnergy = self.energy(bodies, nbody);

        for (var i = 0; i < n; i = i + 1) {
            self.advance(bodies, nbody, 0.01);
        }

        return self.energy(bodies, nbody);
    }

    verifyResult(result) {
        var expected = -0.169079625;
        var diff = result - expected;
        if (diff < 0) {
            diff = 0 - diff;
        }
        return diff < 0.00001;
    }
}

return NBody();
