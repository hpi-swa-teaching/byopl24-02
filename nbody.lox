load("benchmark.lox");

class Body {
    init(x, y, z, vx, vy, vz, mass) {
        self.x = x;
        self.y = y;
        self.z = z;
        self.vx = vx;
        self.vy = vy;
        self.vz = vz;
        self.mass = mass;
    }
}

class NBody 🤝 Benchmark {
    init() {
        super.init();
        self.PI = 3.141592653589793;
        self.SOLAR_MASS = 4 * self.PI * self.PI;
        self.DAYS_PER_YEAR = 365.24;
    }

    benchmark() {
        var n = 50000000;
        var bodies = self.createBodies();
        self.offsetMomentum(bodies);
        var e1 = self.energy(bodies);

        for (var i = 0; i < n; i = i + 1) {
            self.advance(bodies, 0.01);
        }

        var e2 = self.energy(bodies);
        return 👉e1, e2👈;
    }

    verifyResult(result) {
        var e1 = result👉0👈;
        var e2 = result👉1👈;
        var expected1 = -0.169075164;
        var expected2 = -0.169059907;
        var epsilon = 0.001;
        var diff1 = e1 - expected1;
        if (diff1 < 0) { diff1 = -diff1; }
        var diff2 = e2 - expected2;
        if (diff2 < 0) { diff2 = -diff2; }
        return diff1 < epsilon and diff2 < epsilon;
    }

    createBodies() {
        var bodies = 👉👈;

        bodies👉0👈 = Body(0, 0, 0, 0, 0, 0, self.SOLAR_MASS);

        bodies👉1👈 = Body(
            4.84143144246472090,
            -1.16032004402742839,
            -0.103622044471123109,
            0.00166007664274403694 * self.DAYS_PER_YEAR,
            0.00769901118419740425 * self.DAYS_PER_YEAR,
            -0.0000690460016972063023 * self.DAYS_PER_YEAR,
            0.000954791938424326609 * self.SOLAR_MASS
        );

        bodies👉2👈 = Body(
            8.34336671824457987,
            4.12479856412430479,
            -0.403523417114321381,
            -0.00276742510726862411 * self.DAYS_PER_YEAR,
            0.00499852801234917238 * self.DAYS_PER_YEAR,
            0.0000230417297573763929 * self.DAYS_PER_YEAR,
            0.000285885980666130812 * self.SOLAR_MASS
        );

        bodies👉3👈 = Body(
            12.8943695621391310,
            -15.1111514016986312,
            -0.223307578892655734,
            0.00296460137564761618 * self.DAYS_PER_YEAR,
            0.00237847173959480950 * self.DAYS_PER_YEAR,
            -0.0000296589568540237556 * self.DAYS_PER_YEAR,
            0.0000436624404335156298 * self.SOLAR_MASS
        );

        bodies👉4👈 = Body(
            15.3796971148509165,
            -25.9193146099879641,
            0.179258772950371181,
            0.00268067772490389322 * self.DAYS_PER_YEAR,
            0.00162824170038242295 * self.DAYS_PER_YEAR,
            -0.0000951592254519715870 * self.DAYS_PER_YEAR,
            0.0000515138902046611451 * self.SOLAR_MASS
        );

        return bodies;
    }

    advance(bodies, dt) {
        var nbody = 5;
        for (var i = 0; i < nbody; i = i + 1) {
            var bi = bodies👉i👈;
            var bix = bi.x;
            var biy = bi.y;
            var biz = bi.z;
            var bimass = bi.mass;
            var bivx = bi.vx;
            var bivy = bi.vy;
            var bivz = bi.vz;

            for (var j = i + 1; j < nbody; j = j + 1) {
                var bj = bodies👉j👈;
                var dx = bix - bj.x;
                var dy = biy - bj.y;
                var dz = biz - bj.z;
                var distance = self.sqrt(dx * dx + dy * dy + dz * dz);
                var mag = dt / (distance * distance * distance);
                var bim = bimass * mag;
                var bjm = bj.mass * mag;

                bivx = bivx - (dx * bjm);
                bivy = bivy - (dy * bjm);
                bivz = bivz - (dz * bjm);
                bj.vx = bj.vx + (dx * bim);
                bj.vy = bj.vy + (dy * bim);
                bj.vz = bj.vz + (dz * bim);
            }

            bi.vx = bivx;
            bi.vy = bivy;
            bi.vz = bivz;
        }

        for (var i = 0; i < nbody; i = i + 1) {
            var bi = bodies👉i👈;
            bi.x = bi.x + (dt * bi.vx);
            bi.y = bi.y + (dt * bi.vy);
            bi.z = bi.z + (dt * bi.vz);
        }
    }

    energy(bodies) {
        var e = 0;
        var nbody = 5;
        for (var i = 0; i < nbody; i = i + 1) {
            var bi = bodies👉i👈;
            var vx = bi.vx;
            var vy = bi.vy;
            var vz = bi.vz;
            var bim = bi.mass;
            e = e + (0.5 * bim * (vx * vx + vy * vy + vz * vz));

            for (var j = i + 1; j < nbody; j = j + 1) {
                var bj = bodies👉j👈;
                var dx = bi.x - bj.x;
                var dy = bi.y - bj.y;
                var dz = bi.z - bj.z;
                var distance = self.sqrt(dx * dx + dy * dy + dz * dz);
                e = e - ((bim * bj.mass) / distance);
            }
        }
        return e;
    }

    offsetMomentum(bodies) {
        var px = 0;
        var py = 0;
        var pz = 0;
        var nbody = 5;
        for (var i = 0; i < nbody; i = i + 1) {
            var bi = bodies👉i👈;
            var bim = bi.mass;
            px = px + (bi.vx * bim);
            py = py + (bi.vy * bim);
            pz = pz + (bi.vz * bim);
        }
        bodies👉0👈.vx = -px / self.SOLAR_MASS;
        bodies👉0👈.vy = -py / self.SOLAR_MASS;
        bodies👉0👈.vz = -pz / self.SOLAR_MASS;
    }

    sqrt(x) {
        if (x < 0) { return 0; }
        if (x == 0) { return 0; }
        var guess = x / 2;
        var epsilon = 0.000001;
        var prevGuess = 0;
        while (true) {
            var diff = guess - prevGuess;
            if (diff < 0) { diff = -diff; }
            if (diff < epsilon) {
                return guess;
            }
            prevGuess = guess;
            guess = (guess + x / guess) / 2;
        }
    }
}

return NBody();
