fun arithmetic(n) {
    var sum = 0.0;
    for (var i = 0.0; i < n; i = i + 1.0) {
        sum = sum + i * 2.0 - i + i / 2.0;
    }
    return sum;
}

// Measure cold performance (interpreted)
var coldStart = clock();
arithmetic(10000.0);
var coldDuration = clock() - coldStart;

// Warmup
for (var w = 0; w < 10; w = w + 1) {
    arithmetic(10000.0);
}

// Measure warm performance (compiled)
var warmStart = clock();
for (var i = 0; i < 10; i = i + 1) {
    arithmetic(10000.0);
}
var warmDuration = (clock() - warmStart) / 10.0;

print "Cold (interpreted): ";
print coldDuration;
print " us";
print "Warm (compiled): ";
print warmDuration;
print " us";
print "Speedup: ";
print coldDuration / warmDuration;
print "x";
